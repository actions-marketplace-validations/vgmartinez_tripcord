-- .claude/settings.json --
{
  "hooks": {
    "SessionStart": [
      {"matcher": "*", "hooks": [{"type": "command", "command": "sh /home/agent/.codex/notify.sh"}]}
    ]
  }
}
-- images/agent/Dockerfile --
FROM node:22-slim
RUN useradd -m agent
COPY --chown=agent:agent home/ /home/agent/
USER agent
-- images/agent/home/.bashrc --
export PATH="$HOME/.local/bin:$PATH"
-- images/agent/home/.codex/config.toml --
approval_policy = "never"

[features]
hooks = true

[[hooks.Stop]]
matcher = ""

[[hooks.Stop.hooks]]
type = "command"
command = "sh /home/agent/.codex/notify.sh"
timeout = 5
-- images/agent/home/.codex/notify.sh --
exec agent-status hook "$@"
